worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 256; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    # Do not collect URLs, query strings, IPs or credentials in access logs.
    access_log off;
    client_max_body_size 2m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    send_timeout 30s;
    keepalive_timeout 30s;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;
    resolver 127.0.0.11 ipv6=off valid=10s;
    limit_req_zone $binary_remote_addr zone=per_ip:1m rate=10r/s;
    limit_req_zone $binary_remote_addr zone=login_ip:1m rate=6r/m;
    limit_req_zone $server_name zone=login_total:1m rate=30r/m;
    limit_conn_zone $binary_remote_addr zone=connections:1m;
    limit_req_status 429;
    limit_conn_status 429;
    server { listen 8080 default_server; server_name _; return 444; }
    server {
        listen 8080;
        server_name ${CARBENTRA_DEMO_HOST};
        return 308 https://${CARBENTRA_DEMO_HOST}$request_uri;
    }
    server { listen 8443 ssl default_server; ssl_reject_handshake on; }
    server {
        listen 8443 ssl;
        server_name ${CARBENTRA_DEMO_HOST};
        ssl_certificate /run/tls/fullchain.pem;
        ssl_certificate_key /run/tls/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_tickets off;
        add_header Strict-Transport-Security 'max-age=31536000' always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy same-origin always;
        add_header Permissions-Policy 'camera=(), microphone=(), geolocation=()' always;
        add_header X-CARBENTRA-Mode 'public-simulation-only' always;
        limit_conn connections 16;
        limit_req zone=per_ip burst=30 nodelay;
        proxy_http_version 1.1;
        proxy_set_header Host ${CARBENTRA_DEMO_HOST};
        proxy_set_header X-Forwarded-Host ${CARBENTRA_DEMO_HOST};
        proxy_set_header X-Forwarded-Proto https;
        # The sole trusted peer is this gateway. Discard inbound forwarding chains.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_read_timeout 90s;
        location ^~ /api/v1/ingest/ { return 403; }
        location ^~ /api/v1/adapter/ { return 403; }
        location = /api/v1/auth/login {
            limit_req zone=login_ip burst=4 nodelay;
            limit_req zone=login_total burst=8 nodelay;
            set $api_upstream http://api:8000;
            proxy_pass $api_upstream;
        }
        location ~ ^/(api/|health/|assets/spatial/) {
            set $api_upstream http://api:8000;
            proxy_pass $api_upstream;
        }
        location / {
            set $web_upstream http://web:8080;
            proxy_pass $web_upstream;
        }
    }
}
