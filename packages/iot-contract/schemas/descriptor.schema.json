{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carbentra.example/contracts/iot/v1/descriptor.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "product_family": {
      "enum": [
        "PLUG",
        "SWITCH",
        "PRESENCE"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "protocol": {
      "enum": [
        "plug-wire-v2",
        "switch-mqtt-v1",
        "presence-ble-v2",
        "virtual-v1",
        "presence-gatt-v1"
      ]
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "channel_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "capability": {
                  "enum": [
                    "power.active",
                    "voltage.rms",
                    "current.rms",
                    "energy.import",
                    "energy.export",
                    "relay.commanded",
                    "relay.feedback",
                    "presence.pir",
                    "presence.radar",
                    "illuminance.raw",
                    "button.local",
                    "buffer.voltage",
                    "device.health",
                    "control.mode",
                    "control.manual_hold_until"
                  ]
                },
                "access": {
                  "enum": [
                    "read",
                    "write",
                    "read_write"
                  ]
                },
                "unit": {
                  "enum": [
                    "W",
                    "V",
                    "A",
                    "Wh",
                    "boolean",
                    "raw_count",
                    "mV",
                    "status",
                    "mode",
                    "monotonic_ms"
                  ]
                },
                "available": {
                  "type": "boolean"
                }
              },
              "required": [
                "capability",
                "access",
                "unit",
                "available"
              ]
            }
          }
        },
        "required": [
          "channel_id",
          "label",
          "capabilities"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "device_id",
    "product_family",
    "model",
    "protocol",
    "channels"
  ]
}
