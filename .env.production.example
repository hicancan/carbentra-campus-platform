# Copy to .env.production. Keep secrets in local .secrets/, never this file.
CARBENTRA_IMAGE_TAG=reviewed-release-1
CARBENTRA_ADMIN_USERNAME=admin
CARBENTRA_ALLOWED_ORIGINS=["https://campus.example.edu"]
CARBENTRA_TRUSTED_HOSTS=["campus.example.edu","localhost","127.0.0.1","api"]
CARBENTRA_SECRETS_DIR=./.secrets
# Only change after reviewing the actual proxy network and address chain.
CARBENTRA_TRUSTED_PROXY_CIDRS=[]
