# Standalone compose.public-demo.yaml; no secrets or real user data in this file.
# Choose a new ID for each disposable generation; never use operational storage.
CARBENTRA_PUBLIC_DEMO_ID=replace-demo-generation
CARBENTRA_IMAGE_TAG=reviewed-release
CARBENTRA_DEMO_HOST=demo.example.org
CARBENTRA_DEMO_BIND_ADDRESS=127.0.0.1
CARBENTRA_DEMO_NETWORK_PREFIX=172.30.88
CARBENTRA_PUBLIC_DEMO_LIFETIME_HOURS=0
# 0 means continuously running; an explicit 1..720 value opts into timed expiry.
CARBENTRA_PUBLIC_DEMO_MAX_DATABASE_MB=4096
CARBENTRA_ADMIN_USERNAME=demo-administrator
CARBENTRA_PUBLIC_DEMO_VISITOR_USERNAME=visitor
CARBENTRA_PUBLIC_DEMO_OPERATOR_USERNAME=simulation-operator
CARBENTRA_SECRETS_DIR=/absolute/private/public-demo/secrets
CARBENTRA_DEMO_TLS_DIR=/absolute/private/public-demo/tls
